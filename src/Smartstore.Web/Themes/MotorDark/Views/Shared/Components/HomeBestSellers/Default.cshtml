@using Smartstore.Web.Models.Catalog

@model ProductSummaryModel

<div sm-if="Model.Items.Count > 0" role="region" aria-labelledby="homepage-bestsellers-title" class="product-grid bestsellers motor-product-rail block">
    <div class="motor-section-head" data-motor-reveal>
        <div>
            <span class="motor-eyebrow">@T("Themes.MotorDark.Bestsellers.Eyebrow")</span>
            <h2 id="homepage-bestsellers-title" class="motor-section-title">@T("Themes.MotorDark.Bestsellers.Title")</h2>
        </div>
    </div>
    <div class="block-body artlist-no-separators">
        <partial name="Product.List" model="Model" />
    </div>
</div>
