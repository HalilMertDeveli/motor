@* Shopping reassurance. Each item links to the store's own policy pages and is hidden when the page does not exist. *@

@{
    var shippingUrl = await Url.TopicAsync("ShippingInfo");
    var paymentUrl = await Url.TopicAsync("PaymentInfo");
    var ordersUrl = Url.Action("Orders", "Customer");
    var contactUrl = Url.RouteUrl("ContactUs");

    var items = new List<(string Icon, string Title, string Text, string Url, string LinkText)>
    {
        ("mi-truck", T("Themes.MotorDark.Assurance.Shipping.Title").Value, T("Themes.MotorDark.Assurance.Shipping.Text").Value, shippingUrl, T("Themes.MotorDark.Assurance.Shipping.Link").Value),
        ("mi-shield", T("Themes.MotorDark.Assurance.Payment.Title").Value, T("Themes.MotorDark.Assurance.Payment.Text").Value, paymentUrl, T("Themes.MotorDark.Assurance.Payment.Link").Value),
        ("mi-return", T("Themes.MotorDark.Assurance.Orders.Title").Value, T("Themes.MotorDark.Assurance.Orders.Text").Value, ordersUrl, T("Themes.MotorDark.Assurance.Orders.Link").Value),
        ("mi-headset", T("Themes.MotorDark.Assurance.Advice.Title").Value, T("Themes.MotorDark.Assurance.Advice.Text").Value, contactUrl, T("Themes.MotorDark.Assurance.Advice.Link").Value)
    };

    items = items.Where(x => x.Url.HasValue()).ToList();
}

@if (items.Count > 0)
{
    <section class="motor-assurance" aria-label="@T("Themes.MotorDark.Assurance.Label")">
        <ul class="motor-assurance-list" data-motor-stagger>
            @foreach (var item in items)
            {
                <li class="motor-assurance-item">
                    <svg class="motor-assurance-icon" aria-hidden="true"><use href="#@item.Icon" /></svg>
                    <div>
                        <h3 class="motor-assurance-title">@item.Title</h3>
                        <p class="motor-assurance-text">@item.Text</p>
                        <a class="motor-assurance-link" href="@item.Url">@item.LinkText <span aria-hidden="true">→</span></a>
                    </div>
                </li>
            }
        </ul>
    </section>
}
