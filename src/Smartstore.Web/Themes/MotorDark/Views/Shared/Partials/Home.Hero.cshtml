@model string

@*
    MotorDark homepage hero: full-bleed photograph with a cinematic, restrained motion layer.
    Photos live in Themes/MotorDark/wwwroot/images (see CREDITS.txt) and can be replaced
    with the store's own photography using the same file names.
*@

@{
    var primaryCtaUrl = Model.NullEmpty() ?? "#motor-categories";
}

<section class="motor-hero" aria-labelledby="motor-hero-title" data-motor-hero>
    <div class="motor-hero-media" aria-hidden="true">
        <picture>
            <source media="(max-width: 767.98px)" srcset="~/themes/motordark/images/hero-mobile.jpg" />
            <img class="motor-hero-photo"
                 src="~/themes/motordark/images/hero.jpg"
                 alt=""
                 width="2000"
                 height="2667"
                 fetchpriority="high"
                 decoding="async"
                 data-motor-parallax="0.18" />
        </picture>
        <div class="motor-hero-sweep"></div>
        <div class="motor-hero-shade"></div>
        <div class="motor-hero-grain"></div>
    </div>

    <div class="container motor-hero-container">
        <div class="motor-hero-content">
            <span class="motor-eyebrow motor-hero-eyebrow">@T("Themes.MotorDark.Hero.Eyebrow")</span>
            <h1 id="motor-hero-title" class="motor-hero-title">
                <span class="motor-hero-line"><span>@T("Themes.MotorDark.Hero.TitleLine1")</span></span>
                <span class="motor-hero-line"><span>@T("Themes.MotorDark.Hero.TitleLine2") <em>@T("Themes.MotorDark.Hero.TitleAccent")</em></span></span>
            </h1>
            <p class="motor-hero-subtitle">@T("Themes.MotorDark.Hero.Subtitle")</p>
            <div class="motor-hero-actions">
                <a href="@primaryCtaUrl" class="btn btn-primary btn-motor">
                    <span>@T("Themes.MotorDark.Hero.ExploreProducts")</span>
                    <svg class="motor-btn-arrow" aria-hidden="true"><use href="#mi-arrow" /></svg>
                </a>
                <a href="#motor-categories" class="btn btn-motor btn-motor-ghost">
                    <span>@T("Themes.MotorDark.Hero.BrowseCategories")</span>
                </a>
            </div>
        </div>
    </div>

    <a href="#motor-categories" class="motor-hero-scroll" aria-label="@T("Themes.MotorDark.Hero.ScrollToCategories")">
        <span class="motor-hero-scroll-line" aria-hidden="true"></span>
        <span class="motor-hero-scroll-label" aria-hidden="true">@T("Themes.MotorDark.Hero.Scroll")</span>
    </a>
</section>
