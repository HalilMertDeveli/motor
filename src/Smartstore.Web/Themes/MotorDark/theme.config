<?xml version="1.0" encoding="utf-8" ?>
<Theme baseTheme="Flex" title="Prosev Dark" description="Prosev 2026 kataloğunun görünümünde koyu mağaza teması: siyah, katalog kırmızısı ve beyaz" author="Prosev" version="1.1">

    <Vars>
        <!-- Graphite scale (inverted: 100 = darkest surface, 900 = brightest text) -->
        <Var name="gray-100" type="Color">#15171b</Var>
        <Var name="gray-200" type="Color">#1c1f24</Var>
        <Var name="gray-300" type="Color">#2a2e35</Var>
        <Var name="gray-400" type="Color">#3a3f47</Var>
        <Var name="gray-500" type="Color">#5e636c</Var>
        <Var name="gray-600" type="Color">#9a9ca3</Var>
        <Var name="gray-700" type="Color">#bdbfc4</Var>
        <Var name="gray-800" type="Color">#dcddda</Var>
        <Var name="gray-900" type="Color">#f4f4f2</Var>

        <Var name="red" type="Color">#ff5059</Var>
        <Var name="orange" type="Color">#ff5a1f</Var>
        <Var name="yellow" type="Color">#ffc53d</Var>
        <Var name="green" type="Color">#35c98a</Var>
        <Var name="blue" type="Color">#4ea1ff</Var>

        <!-- Brand colors -->
        <Var name="primary" type="Color">#e3262f</Var>
        <Var name="secondary" type="Color">#2a2e35</Var>
        <Var name="success" type="Color">$green</Var>
        <Var name="danger" type="Color">$red</Var>
        <Var name="warning" type="Color">#ffb020</Var>
        <Var name="info" type="Color">$blue</Var>
        <Var name="light" type="Color">#1c1f24</Var>
        <Var name="dark" type="Color">#000000</Var>

        <!-- Components -->
        <Var name="border-radius" type="String">4px</Var>
        <Var name="border-radius-sm" type="String">3px</Var>
        <Var name="border-radius-lg" type="String">6px</Var>
        <Var name="border-radius-xl" type="String">10px</Var>
        <Var name="border-radius-xxl" type="String">16px</Var>

        <!-- Layout -->
        <Var name="boxed" type="Boolean">false</Var>

        <!-- Main site colors -->
        <Var name="site-bg" type="Color">#08090b</Var>
        <Var name="body-bg" type="Color">#08090b</Var>
        <Var name="body-color" type="Color">#dcddda</Var>
        <Var name="yiq-text-dark" type="Color">#08090b</Var>
        <Var name="yiq-text-light" type="Color">#ffffff</Var>
        <Var name="body-secondary-color" type="Color">#9a9ca3</Var>
        <Var name="body-tertiary-color" type="Color">#5e636c</Var>
        <Var name="text-muted" type="Color">$body-secondary-color</Var>
        <Var name="link-color" type="Color">#ff5059</Var>

        <!-- Secondary Button -->
        <Var name="btn-secondary-bg" type="Color">#1a1d22</Var>

        <!-- Footer -->
        <Var name="inverse-footer" type="Boolean">true</Var>
        <Var name="footer-bg" type="Color">#050607</Var>
        <Var name="footer-color" type="Color">$body-color</Var>
        <Var name="footer-color-muted" type="Color">$body-secondary-color</Var>
        <Var name="footer-inverse-color" type="Color">#f4f4f2</Var>
        <Var name="footer-inverse-color-muted" type="Color">rgba(#f4f4f2, 0.62)</Var>
        <Var name="footer-social-bg" type="Color">transparent</Var>
        <Var name="footer-social-color" type="Color">rgba(#f4f4f2, 0.62)</Var>

        <!-- Typography -->
        <Var name="font-family-sans-serif" type="String">-apple-system, system-ui, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif</Var>
        <Var name="font-size-base" type="String">0.9375rem</Var>
        <Var name="font-size-lg" type="String">1.0625rem</Var>
        <Var name="font-size-sm" type="String">0.875rem</Var>
        <Var name="font-size-xs" type="String">0.8125rem</Var>
        <Var name="font-weight-medium" type="String">600</Var>

        <Var name="headings-font-family" type="String">"Barlow Semi Condensed", "Arial Narrow", Arial, sans-serif</Var>
        <Var name="headings-font-weight" type="String">700</Var>
        <Var name="headings-line-height" type="String">1.05</Var>
        <Var name="headings-color" type="String">#f4f4f2</Var>
        <Var name="lead-font-weight" type="String">400</Var>

        <Var name="h1-font-size" type="String">2.5rem</Var>
        <Var name="h2-font-size" type="String">2rem</Var>
        <Var name="h3-font-size" type="String">1.625rem</Var>
        <Var name="h4-font-size" type="String">1.3125rem</Var>
        <Var name="h5-font-size" type="String">1.0625rem</Var>

        <Var name="badge-content-shift" type="String">0px</Var>

        <!-- Header -->
        <Var name="header-bg" type="Color">#08090b</Var>
        <Var name="header-color" type="Color">#f4f4f2</Var>
        <Var name="inverse-menubar" type="Boolean">true</Var>
        <Var name="inverse-shopbar" type="Boolean">true</Var>
        <Var name="inverse-navbar" type="Boolean">true</Var>
        <Var name="menubar-bg" type="Color">transparent</Var>
        <Var name="shopbar-bg" type="Color">transparent</Var>
        <Var name="megamenu-bg" type="Color">transparent</Var>
        <Var name="header-color-muted" type="Color">#9a9ca3</Var>

        <Var name="menubar-inverse-color" type="Color">#bdbfc4</Var>
        <Var name="shopbar-inverse-color" type="Color">#f4f4f2</Var>
        <Var name="megamenu-inverse-color" type="Color">#f4f4f2</Var>
        <Var name="megamenu-line-height" type="String">1.8</Var>

        <!-- Megamenu Dropdowns -->
        <Var name="megamenu-dropdown-bg" type="Color">#111317</Var>
        <Var name="megamenu-heading-color" type="Color">#f4f4f2</Var>
        <Var name="megamenu-subitem-color" type="Color">#9a9ca3</Var>
        <Var name="megamenu-text-color" type="Color">#dcddda</Var>
        <Var name="megamenu-rotator-bg" type="Color">rgba(#111317, 0.94)</Var>

        <!-- Search -->
        <Var name="searchbox-pill" type="Boolean">false</Var>
        <Var name="searchbox-shadow" type="Boolean">false</Var>
        <Var name="searchbox-outline-width" type="String">2px</Var>
        <Var name="searchbox-outline-color" type="Color">$primary</Var>
        <Var name="searchbox-bg-1" type="Color">#15171b</Var>
        <Var name="searchbox-bg-2" type="Color">#111317</Var>
        <Var name="searchbox-bg-mobile" type="Color">#15171b</Var>
        <Var name="searchbox-color-1" type="Color">#f4f4f2</Var>
        <Var name="searchbox-color-2" type="Color">#f4f4f2</Var>
        <Var name="searchbox-border-1" type="Color">rgba(#fff, 0.08)</Var>
        <Var name="searchbox-border-2" type="Color">rgba(#fff, 0.12)</Var>
        <Var name="searchbox-border-mobile" type="Color">rgba(#fff, 0.08)</Var>
        <Var name="searchbox-hit-tag-color" type="Color">$primary</Var>

        <!-- Cards -->
        <Var name="card-border-radius" type="String">$border-radius-lg</Var>
        <Var name="card-border-color" type="Color">rgba(#fff, 0.07)</Var>
        <Var name="card-cap-bg" type="Color">rgba(#fff, 0.03)</Var>
        <Var name="card-bg" type="Color">#111317</Var>

        <!-- Dropdowns -->
        <Var name="dropdown-bg" type="Color">#15171b</Var>
        <Var name="dropdown-color" type="Color">$body-color</Var>
        <Var name="dropdown-border-color" type="Color">rgba(#fff, 0.08)</Var>
        <Var name="dropdown-border-radius" type="Color">$border-radius-lg</Var>
        <Var name="dropdown-divider-bg" type="Color">rgba(#fff, 0.08)</Var>
        <Var name="dropdown-box-shadow" type="String">0 18px 48px rgba(0, 0, 0, 0.55)</Var>
        <Var name="dropdown-link-color" type="Color">#bdbfc4</Var>
        <Var name="dropdown-link-hover-color" type="Color">#ffffff</Var>
        <Var name="dropdown-link-hover-bg" type="Color">rgba(#fff, 0.06)</Var>

        <!-- Tables-->
        <Var name="table-bg" type="Color">transparent</Var>
        <Var name="table-accent-bg" type="Color">rgba(#fff, 0.025)</Var>
        <Var name="table-hover-bg" type="Color">rgba(#fff, 0.05)</Var>
        <Var name="table-active-bg" type="Color">$table-hover-bg</Var>
        <Var name="table-border-color" type="Color">rgba(#fff, 0.08)</Var>

        <!-- MotorDark: show the uploaded store logo instead of the PROSEV wordmark -->
        <Var name="motor-use-logo" type="Boolean">false</Var>

        <!-- Misc  -->
        <Var name="shopbar-label" type="Select#brand-colors">primary</Var>
        <Var name="nav-tabs-active-link-color" type="Color">#f4f4f2</Var>
        <Var name="product-price-color" type="Color">#f4f4f2</Var>
        <Var name="product-detail-addtocart-box-bg" type="Color">#111317</Var>
        <Var name="register-box-bg" type="Color">#111317</Var>
        <Var name="cart-footer-bg" type="Color">#111317</Var>
        <Var name="costep-progress-color" type="Color">$primary</Var>
        <Var name="offcanvas-cart-footer" type="Color">#111317</Var>
        <Var name="art-active-bg-color" type="Color">#111317</Var>
        <Var name="art-active-border-color" type="Color">rgba(#fff, 0.08)</Var>
    </Vars>
</Theme>
