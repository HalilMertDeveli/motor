@model FitmentResultsModel

@{
    Layout = "_Layout";

    var title = Model.Selection != null
        ? T("Plugins.MotorShop.Fitment.Results.Title", Model.Selection.DisplayName).ToString()
        : T("Plugins.MotorShop.Fitment.Picker.Title").ToString();

    Assets.AppendTitleParts(title);
    ViewBag.HideLeftCol = true; // ...on mobile
}

@if (Model.Products != null)
{
    <widget target-zone="left">
        <partial name="Search.Filters" model="Model.Products" />
    </widget>
}

<div class="page motor-fitment-page">
    @await Component.InvokeAsync("VehiclePicker", new { selection = Model.Selection })

    @if (Model.Selection != null)
    {
        <div class="page-title">
            <h1 class="h3">@title</h1>
            @if (Model.SearchResult?.TotalHitsCount > 0)
            {
                <partial name="SearchResultHitsCount" model="Model.SearchResult" />
            }
        </div>

        <div class="page-body">
            @if (Model.Products != null && Model.Products.Items.Count > 0)
            {
                <div class="product-list-container">
                    <partial name="Product.List" model="Model.Products" />
                </div>
            }
            else
            {
                <div class="alert alert-warning" role="alert">
                    @T("Plugins.MotorShop.Fitment.Results.Empty", Model.Selection.DisplayName)
                </div>
            }
        </div>
    }
</div>
