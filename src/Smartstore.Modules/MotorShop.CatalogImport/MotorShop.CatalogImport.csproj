<Project Sdk="Microsoft.NET.Sdk.Razor">
	<PropertyGroup>
		<Product>MotorShop Catalog Import</Product>
		<OutputPath>..\..\Smartstore.Web\Modules\MotorShop.CatalogImport</OutputPath>
		<OutDir>$(OutputPath)</OutDir>
	</PropertyGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="MotorShop.CatalogImport.Tests" />
	</ItemGroup>
	<ItemGroup>
		<!-- Bundled research datasets, read by BundledResearchService. -->
		<Content Remove="Research\**" />
		<None Remove="Research\**" />
		<EmbeddedResource Include="Research\**\*.json" LogicalName="MotorShop.CatalogImport.Research.%(Filename)%(Extension)" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\Smartstore.Web\Smartstore.Web.csproj">
			<Private>False</Private>
			<CopyLocal>False</CopyLocal>
			<CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
		</ProjectReference>
		<!-- Loaded by the module system (see DependsOn in module.json), not copied. -->
		<ProjectReference Include="..\MotorShop.Fitment\MotorShop.Fitment.csproj">
			<Private>False</Private>
			<CopyLocal>False</CopyLocal>
			<CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
		</ProjectReference>
	</ItemGroup>
</Project>
