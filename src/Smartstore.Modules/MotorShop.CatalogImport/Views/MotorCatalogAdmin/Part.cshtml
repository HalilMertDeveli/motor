@model PartDetailModel
@{
    Layout = "_ConfigureModule";
    var p = Model.Part;
    var r = Model.Readiness;
    var res = "Plugins.MotorShop.CatalogImport.";
}

<partial name="_Nav" />

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h4 class="mb-1">@p.Brand <span class="font-monospace">@p.Mpn</span></h4>
        <div class="text-muted">@p.ProductName · @T(res + "Type." + p.ProductType) · @T(res + "Classification." + p.Classification)</div>
    </div>
    <div class="text-right">
        <partial name="_StateBadge" model="p.State" />
        @if (p.ProductId.HasValue)
        {
            <a class="btn btn-sm btn-light ml-2 ms-2" href="@Url.Action("Edit", "Product", new { id = p.ProductId, area = "Admin" })">@T(res + "Part.OpenProduct")</a>
        }
    </div>
</div>

@if (p.HasPendingChanges && Model.PendingChanges != null)
{
    <div class="alert alert-warning">
        <div class="mb-2">@T(res + "Part.PendingChanges.Hint")</div>
        <pre class="small bg-light p-2 mb-2" style="max-height: 240px; overflow: auto">@p.PendingChangesJson</pre>
        <div class="d-flex gap-2">
            <form asp-action="AcceptChanges" asp-route-id="@p.Id" method="post"><button class="btn btn-sm btn-warning" type="submit">@T(res + "Part.AcceptChanges")</button></form>
            <form asp-action="DiscardChanges" asp-route-id="@p.Id" method="post"><button class="btn btn-sm btn-light" type="submit">@T(res + "Part.DiscardChanges")</button></form>
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-header"><strong>@T(res + "Part.Provenance")</strong></div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-4">@T(res + "Source")</dt>
                    <dd class="col-sm-8">@Model.Source?.Name <partial name="_PermissionBadge" model="Model.Source?.PermissionStatus ?? SourcePermissionStatus.Rejected" /></dd>
                    <dt class="col-sm-4">@T(res + "Part.Verification")</dt>
                    <dd class="col-sm-8">@T(res + "Verification." + p.VerificationStatus) · @T(res + "Confidence." + p.Confidence)</dd>
                    <dt class="col-sm-4">@T(res + "Part.Accessed")</dt>
                    <dd class="col-sm-8">@(p.AccessedOn?.ToString("yyyy-MM-dd") ?? "-") · @p.RetrievalMethod</dd>
                    <dt class="col-sm-4">@T(res + "Part.LastSeen")</dt>
                    <dd class="col-sm-8">@p.LastSeenOnUtc.ToString("yyyy-MM-dd HH:mm") @if (p.IsMissingFromSource) { <span class="badge badge-danger bg-danger">@T(res + "Part.MissingFromSource")</span> }</dd>
                    <dt class="col-sm-4">GTIN</dt>
                    <dd class="col-sm-8">@(p.Gtin ?? "-")</dd>
                    <dt class="col-sm-4">@T(res + "Part.Oem")</dt>
                    <dd class="col-sm-8">@(p.OemReferences ?? "-")</dd>
                    @if (p.SupersededBy.HasValue())
                    {
                        <dt class="col-sm-4">@T(res + "Part.SupersededBy")</dt>
                        <dd class="col-sm-8 font-monospace">@p.SupersededBy</dd>
                    }
                    <dt class="col-sm-4">@T(res + "Part.ImageRights")</dt>
                    <dd class="col-sm-8">@(p.ImageRights ?? "-")</dd>
                    <dt class="col-sm-4">@T(res + "Part.MissingData")</dt>
                    <dd class="col-sm-8">@(p.MissingData ?? "-")</dd>
                    @if (p.Notes.HasValue())
                    {
                        <dt class="col-sm-4">@T(res + "Part.Notes")</dt>
                        <dd class="col-sm-8">@p.Notes</dd>
                    }
                </dl>
                <hr />
                <ul class="small mb-0 ps-3 pl-3">
                    @foreach (var s in Model.Sources)
                    {
                        <li>@if (CatalogValidator.IsHttpUrl(s.Url)) { <a href="@s.Url" target="_blank" rel="noopener noreferrer" class="text-break">@s.Url</a> } else { <span class="text-break">@s.Url</span> } ·@s.Organization · @s.Type · @s.Accessed · @string.Join(", ", s.Supports)</li>
                    }
                </ul>
            </div>
        </div>

        @if (Model.Specs.Count > 0)
        {
            <div class="card mb-4">
                <div class="card-header"><strong>@T(res + "Part.Specs")</strong></div>
                <table class="table table-sm mb-0">
                    @foreach (var (key, value) in Model.Specs)
                    {
                        <tr><th class="w-50">@key</th><td>@value</td></tr>
                    }
                    @if (p.PackageQuantity.HasValue)
                    {
                        <tr><th>@T(res + "Part.PackageQuantity")</th><td>@p.PackageQuantity</td></tr>
                    }
                </table>
            </div>
        }

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>@T(res + "Part.Fitment")</strong>
                <form asp-action="ApproveExactMatches" asp-route-id="@p.Id" method="post">
                    <button class="btn btn-sm btn-success" type="submit">@T(res + "Part.ApproveExact")</button>
                </form>
            </div>
            <div class="card-body small text-muted pb-0">@T(res + "Part.Fitment.Hint")</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>@T(res + "Part.Fitment.Stated")</th>
                            <th>@T(res + "Part.Fitment.Matches")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Fitment.Count == 0)
                        {
                            <tr><td colspan="2" class="text-muted">@T(res + "Part.Fitment.None")</td></tr>
                        }
                        @foreach (var row in Model.Fitment)
                        {
                            var f = row.Fitment;
                            <tr>
                                <td>
                                    <div>@f.Make @f.Model @f.Variant <span class="text-nowrap">@f.YearFrom–@(f.YearTo?.ToString() ?? "…")</span> @f.Position</div>
                                    @if (CatalogValidator.IsHttpUrl(f.SourceUrl))
                                    {
                                        <a class="small text-break" href="@f.SourceUrl" target="_blank" rel="noopener noreferrer">@f.SourceUrl</a>
                                    }
                                    @if (f.IsMissingFromSource) { <span class="badge badge-danger bg-danger">@T(res + "Part.MissingFromSource")</span> }
                                </td>
                                <td>
                                    @if (row.Matches.Count == 0)
                                    {
                                        <span class="text-muted">@T(res + "Part.Fitment.NoVehicle")</span>
                                    }
                                    @foreach (var (m, v) in row.Matches)
                                    {
                                        <div class="d-flex flex-wrap align-items-center gap-1 mb-1">
                                            <span>@v.DisplayName</span>
                                            <span class="badge badge-@(m.Kind == FitmentMatchKind.Exact ? "info" : "warning") bg-@(m.Kind == FitmentMatchKind.Exact ? "info" : "warning")">@T(res + "MatchKind." + m.Kind)</span>
                                            <span class="badge badge-light bg-light text-dark">@T(res + "MatchStatus." + m.Status)</span>
                                            @if (m.Kind == FitmentMatchKind.Exact && m.Status != FitmentMatchStatus.Approved)
                                            {
                                                <form asp-action="ApproveMatch" asp-route-id="@p.Id" asp-route-matchId="@m.Id" method="post" class="d-inline"><button class="btn btn-xs btn-sm py-0 btn-success" type="submit">@T(res + "Approve")</button></form>
                                            }
                                            @if (m.Status != FitmentMatchStatus.Rejected)
                                            {
                                                <form asp-action="RejectMatch" asp-route-id="@p.Id" asp-route-matchId="@m.Id" method="post" class="d-inline"><button class="btn btn-xs btn-sm py-0 btn-light" type="submit">@T(res + "Reject")</button></form>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header"><strong>@T(res + "Part.Offers")</strong></div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>@T(res + "Source")</th>
                            <th>SKU</th>
                            <th>@T(res + "Part.Offer.Cost")</th>
                            <th>@T(res + "Part.Offer.Stock")</th>
                            <th>@T(res + "Part.Offer.LeadTime")</th>
                            <th>@T(res + "Part.Offer.Verified")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Offers.Count == 0)
                        {
                            <tr><td colspan="6" class="text-muted">@T(res + "Part.Offer.None")</td></tr>
                        }
                        @foreach (var o in Model.Offers)
                        {
                            <tr class="@(o.Offer.IsActive ? null : "text-muted")">
                                <td>@o.SourceName <partial name="_PermissionBadge" model="o.SourcePermission" /></td>
                                <td class="font-monospace">@o.Offer.SupplierSku</td>
                                <td>@(o.Offer.PurchaseCost?.ToString("0.00", CultureInfo.InvariantCulture) ?? "-") @o.Offer.Currency</td>
                                <td>@(o.Offer.StockQuantity?.ToString() ?? "-")</td>
                                <td>@(o.Offer.LeadTimeDays?.ToString() ?? "-")</td>
                                <td>@o.Offer.VerifiedOnUtc.ToString("yyyy-MM-dd") @(o.Offer.IsActive ? "" : "(" + T(res + "Part.Offer.Inactive") + ")")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-header"><strong>@T(res + "Part.Readiness")</strong></div>
            <div class="card-body">
                <h6>@T(res + "State.VerifiedReference")</h6>
                @if (r.CanBeReference)
                {
                    <p class="text-success small">@T(res + "Part.Readiness.Met")</p>
                }
                else
                {
                    <ul class="small text-danger">@foreach (var m in r.MissingForReference) { <li>@T(res + "Requirement." + m)</li> }</ul>
                }
                @if (Model.ProductConflicts.Count > 0)
                {
                    <p class="small mb-1">@T(res + "Part.ProductConflicts")</p>
                    <ul class="small">
                        @foreach (var c in Model.ProductConflicts)
                        {
                            <li><a href="@Url.Action("Edit", "Product", new { id = c.ProductId, area = "Admin" })">#@c.ProductId @c.Name</a> · SKU @(c.Sku ?? "-") · MPN @(c.Mpn ?? "-") · GTIN @(c.Gtin ?? "-")</li>
                        }
                    </ul>
                }
                <h6>@T(res + "State.ReadyForSale")</h6>
                @if (r.MissingForSale.Count == 0)
                {
                    <p class="text-success small">@T(res + "Part.Readiness.Met")</p>
                }
                else
                {
                    <ul class="small text-danger">@foreach (var m in r.MissingForSale) { <li>@T(res + "Requirement." + m)</li> }</ul>
                }

                <div class="d-flex flex-wrap gap-2">
                    @if (p.State == PartPublicationState.ResearchCandidate || p.State == PartPublicationState.Rejected)
                    {
                        <form asp-action="ApproveReference" asp-route-id="@p.Id" method="post"><button class="btn btn-info" type="submit" disabled="@(!r.CanBeReference)">@T(res + "Part.ApproveReference")</button></form>
                    }
                    @if (p.State == PartPublicationState.VerifiedReference)
                    {
                        <form asp-action="ApproveSale" asp-route-id="@p.Id" method="post"><button class="btn btn-success" type="submit" disabled="@(!r.CanBeSold)">@T(res + "Part.ApproveSale")</button></form>
                    }
                    @if (p.State >= PartPublicationState.VerifiedReference)
                    {
                        <form asp-action="Withdraw" asp-route-id="@p.Id" method="post"><button class="btn btn-light" type="submit">@T(res + "Part.Withdraw")</button></form>
                    }
                </div>

                @if (p.State != PartPublicationState.Rejected)
                {
                    <form asp-action="Reject" asp-route-id="@p.Id" method="post" class="mt-3">
                        <div class="input-group input-group-sm">
                            <input class="form-control" name="reason" placeholder="@T(res + "Part.RejectReason")" required />
                            <button class="btn btn-danger" type="submit">@T(res + "Reject")</button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="small text-danger mt-3 mb-0">@T(res + "Part.Rejected"): @p.RejectionReason</p>
                }

                <div class="small text-muted mt-3">
                    @if (p.ReferenceApprovedOnUtc.HasValue) { <div>@T(res + "Part.ReferenceApproved", p.ReferenceApprovedOnUtc.Value.ToString("yyyy-MM-dd HH:mm"), p.ReferenceApprovedBy)</div> }
                    @if (p.SaleApprovedOnUtc.HasValue) { <div>@T(res + "Part.SaleApproved", p.SaleApprovedOnUtc.Value.ToString("yyyy-MM-dd HH:mm"), p.SaleApprovedBy)</div> }
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header"><strong>@T(res + "Part.Commerce")</strong></div>
            <div class="card-body">
                <p class="small text-muted">@T(res + "Part.Commerce.Hint")</p>
                <form asp-action="Commerce" asp-route-id="@p.Id" method="post" class="row g-2">
                    <div class="col-6">
                        <label class="form-label" for="approvedPrice">@T(res + "Part.ApprovedPrice")</label>
                        <input class="form-control" id="approvedPrice" name="approvedPrice" type="number" step="0.01" min="0.01" value="@p.ApprovedPrice?.ToString("0.00", CultureInfo.InvariantCulture)" />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="taxCategoryId">@T(res + "Part.TaxCategory")</label>
                        <select class="form-control" id="taxCategoryId" name="taxCategoryId">
                            <option value="">-</option>
                            @foreach (var (id, name) in Model.TaxCategories)
                            {
                                <option value="@id" selected="@(p.TaxCategoryId == id)">@name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="categoryId">@T(res + "Part.Category")</label>
                        <select class="form-control" id="categoryId" name="categoryId">
                            <option value="">-</option>
                            @foreach (var (id, name) in Model.Categories)
                            {
                                <option value="@id" selected="@(p.CategoryId == id)">@name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="imageRightsApproved" name="imageRightsApproved" value="true" checked="@p.ImageRightsApproved" />
                            <label class="form-check-label" for="imageRightsApproved">@T(res + "Part.ImageRightsApproved")</label>
                        </div>
                        <input class="form-control form-control-sm mt-1" name="imageRightsNote" value="@p.ImageRightsNote" placeholder="@T(res + "Part.ImageRightsNote")" />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">@T("Admin.Common.Save")</button>
                    </div>
                </form>
                @if (p.CandidateImageUrls.HasValue())
                {
                    <hr />
                    <div class="small">@T(res + "Part.CandidateImages")</div>
                    <ul class="small mb-0">@foreach (var url in p.CandidateImageUrls.Split('\n')) { <li class="text-break">@url</li> }</ul>
                }
            </div>
        </div>
    </div>
</div>
