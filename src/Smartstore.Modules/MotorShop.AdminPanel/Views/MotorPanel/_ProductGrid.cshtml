@model ProductListModel
@{
    var f = Model.Filter;

    string SortUrl(ProductSort asc, ProductSort desc)
        => Url.Action("Index", "MotorPanel", f.ToRouteValues(1, f.Sort == asc ? desc : asc)) + "#mp-products";

    string AriaSort(ProductSort asc, ProductSort desc)
        => f.Sort == asc ? "ascending" : f.Sort == desc ? "descending" : null;

    var labelHidden = T("Plugins.MotorShop.AdminPanel.Price.CallForPrice").Value;
    var labelVisible = T("Plugins.MotorShop.AdminPanel.Price.Visible").Value;
    var labelPublished = T("Plugins.MotorShop.AdminPanel.Status.Published").Value;
    var labelUnpublished = T("Plugins.MotorShop.AdminPanel.Status.Unpublished").Value;
}

<div class="mp-grid__meta" data-total="@Model.TotalCount" data-page-ids="@string.Join(",", Model.Rows.Select(x => x.Id))">
    <span>@T("Plugins.MotorShop.AdminPanel.ResultCount", Model.TotalCount.ToString("N0"))</span>
    <span class="mp-muted">@T("Plugins.MotorShop.AdminPanel.PricesIn", Model.CurrencyCode)</span>
</div>

@if (Model.Rows.Count == 0)
{
    <div class="mp-empty">
        <p>@T("Plugins.MotorShop.AdminPanel.NoProducts")</p>
        <a class="mp-link" href="@Url.Action("Index", "MotorPanel", new { area = "Admin" })#mp-products">@T("Plugins.MotorShop.AdminPanel.ResetFilters")</a>
    </div>
}
else
{
    <div class="mp-table-wrap">
        <table class="mp-table mp-table--products">
            <thead>
                <tr>
                    @if (Model.CanUpdate)
                    {
                        <th scope="col" class="mp-col-check">
                            <input type="checkbox" class="mp-check" data-select-page aria-label="@T("Plugins.MotorShop.AdminPanel.Bulk.SelectPage")" />
                        </th>
                    }
                    <th scope="col" class="mp-col-thumb"><span class="mp-sr">@T("Plugins.MotorShop.AdminPanel.Col.Image")</span></th>
                    <th scope="col" aria-sort="@AriaSort(ProductSort.NameAsc, ProductSort.NameDesc)">
                        <a class="mp-sort" href="@SortUrl(ProductSort.NameAsc, ProductSort.NameDesc)">@T("Plugins.MotorShop.AdminPanel.Col.Name")</a>
                    </th>
                    <th scope="col">@T("Plugins.MotorShop.AdminPanel.Col.Sku")</th>
                    <th scope="col">@T("Plugins.MotorShop.AdminPanel.Col.Categories")</th>
                    <th scope="col" class="mp-num" aria-sort="@AriaSort(ProductSort.PriceAsc, ProductSort.PriceDesc)">
                        <a class="mp-sort" href="@SortUrl(ProductSort.PriceAsc, ProductSort.PriceDesc)">@T("Plugins.MotorShop.AdminPanel.Col.Price")</a>
                    </th>
                    <th scope="col" class="mp-num">@T("Plugins.MotorShop.AdminPanel.Col.SpecialPrice")</th>
                    <th scope="col" class="mp-num" aria-sort="@AriaSort(ProductSort.StockAsc, ProductSort.StockDesc)">
                        <a class="mp-sort" href="@SortUrl(ProductSort.StockAsc, ProductSort.StockDesc)">@T("Plugins.MotorShop.AdminPanel.Col.Stock")</a>
                    </th>
                    <th scope="col">@T("Plugins.MotorShop.AdminPanel.Col.PriceVisibility")</th>
                    <th scope="col">@T("Plugins.MotorShop.AdminPanel.Col.Status")</th>
                    <th scope="col" class="mp-col-actions"><span class="mp-sr">@T("Plugins.MotorShop.AdminPanel.Col.Actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Rows)
                {
                    var editUrl = Url.Action("Edit", "MotorPanelProduct", new { area = "Admin", id = p.Id });
                    var zeroPrice = p.Price.Amount <= 0 && !p.CallForPrice;
                    <tr data-id="@p.Id" data-name="@p.Name">
                        @if (Model.CanUpdate)
                        {
                            <td class="mp-col-check">
                                <input type="checkbox" class="mp-check" data-select value="@p.Id" aria-label="@T("Plugins.MotorShop.AdminPanel.Bulk.SelectRow", p.Name)" />
                            </td>
                        }
                        <td class="mp-col-thumb">
                            @if (p.ThumbnailUrl.HasValue())
                            {
                                <img class="mp-thumb" src="@p.ThumbnailUrl" alt="" loading="lazy" width="40" height="40" />
                            }
                            else
                            {
                                <span class="mp-thumb mp-thumb--empty" aria-hidden="true"></span>
                            }
                        </td>
                        <td class="mp-col-name">
                            <button type="button" class="mp-link mp-link--plain mp-link-btn" data-open-editor="@editUrl">@p.Name</button>
                        </td>
                        <td class="mp-mono mp-col-sku">@(p.Sku.NullEmpty() ?? "-")</td>
                        <td class="mp-col-cats">
                            @if (p.Categories.Count == 0)
                            {
                                <span class="mp-muted">-</span>
                            }
                            else
                            {
                                <span class="mp-truncate" title="@string.Join(", ", p.Categories)">@string.Join(", ", p.Categories)</span>
                            }
                        </td>
                        <td class="mp-num mp-nowrap mp-col-price">
                            @if (Model.CanUpdate)
                            {
                                <button type="button" class="mp-cell" data-edit="price" data-value="@p.PriceValue"
                                        aria-label="@T("Plugins.MotorShop.AdminPanel.Edit.Price", p.Name)">@p.Price</button>
                            }
                            else
                            {
                                @p.Price
                            }
                            <span class="mp-badge mp-badge--red" data-zero-badge title="@T("Plugins.MotorShop.AdminPanel.ZeroPrice.Hint")" hidden="@(!zeroPrice)">@T("Plugins.MotorShop.AdminPanel.ZeroPrice")</span>
                        </td>
                        <td class="mp-num mp-nowrap mp-col-special">
                            @if (Model.CanUpdate)
                            {
                                <button type="button" class="mp-cell@(p.SpecialPrice.HasValue && !p.SpecialPriceActive ? " mp-muted mp-strike" : "")" data-edit="specialPrice" data-value="@p.SpecialPriceValue" data-optional="true"
                                        title="@(p.SpecialPrice.HasValue && !p.SpecialPriceActive ? T("Plugins.MotorShop.AdminPanel.SpecialPriceInactive").Value : null)"
                                        aria-label="@T("Plugins.MotorShop.AdminPanel.Edit.SpecialPrice", p.Name)">@(p.SpecialPrice.HasValue ? p.SpecialPrice.Value.ToString() : "-")</button>
                            }
                            else if (p.SpecialPrice.HasValue)
                            {
                                @p.SpecialPrice.Value
                            }
                            else
                            {
                                <span class="mp-muted">-</span>
                            }
                        </td>
                        <td class="mp-num mp-nowrap mp-col-stock">
                            @switch (p.Stock)
                            {
                                case StockState.InStock:
                                case StockState.OutOfStock:
                                    if (Model.CanUpdate)
                                    {
                                        <button type="button" class="mp-cell mp-badge @(p.Stock == StockState.InStock ? "mp-badge--green" : "mp-badge--red")" data-edit="stock" data-value="@p.StockQuantity" data-integer="true"
                                                aria-label="@T("Plugins.MotorShop.AdminPanel.Edit.Stock", p.Name)">@p.StockQuantity.ToString("N0")</button>
                                    }
                                    else
                                    {
                                        <span class="mp-badge @(p.Stock == StockState.InStock ? "mp-badge--green" : "mp-badge--red")">@p.StockQuantity.ToString("N0")</span>
                                    }
                                    break;
                                case StockState.ByAttributes:
                                    <span class="mp-badge mp-badge--gray">@T("Plugins.MotorShop.AdminPanel.Stock.ByAttributes")</span>
                                    break;
                                default:
                                    <span class="mp-badge mp-badge--gray">@T("Plugins.MotorShop.AdminPanel.Stock.NotTracked")</span>
                                    break;
                            }
                        </td>
                        <td class="mp-col-visibility">
                            @if (Model.CanUpdate)
                            {
                                <button type="button" class="mp-badge mp-badge-btn @(p.CallForPrice ? "mp-badge--amber" : "mp-badge--green")" data-toggle="callForPrice" data-value="@(p.CallForPrice ? "true" : "false")"
                                        data-label-true="@labelHidden" data-label-false="@labelVisible" data-class-true="mp-badge--amber" data-class-false="mp-badge--green"
                                        title="@T("Plugins.MotorShop.AdminPanel.Toggle.Hint")">@(p.CallForPrice ? labelHidden : labelVisible)</button>
                            }
                            else
                            {
                                <span class="mp-badge @(p.CallForPrice ? "mp-badge--amber" : "mp-badge--green")">@(p.CallForPrice ? labelHidden : labelVisible)</span>
                            }
                        </td>
                        <td class="mp-col-status">
                            @if (Model.CanUpdate)
                            {
                                <button type="button" class="mp-badge mp-badge-btn @(p.Published ? "mp-badge--blue" : "mp-badge--gray")" data-toggle="published" data-value="@(p.Published ? "true" : "false")"
                                        data-label-true="@labelPublished" data-label-false="@labelUnpublished" data-class-true="mp-badge--blue" data-class-false="mp-badge--gray"
                                        title="@T("Plugins.MotorShop.AdminPanel.Toggle.Hint")">@(p.Published ? labelPublished : labelUnpublished)</button>
                            }
                            else
                            {
                                <span class="mp-badge @(p.Published ? "mp-badge--blue" : "mp-badge--gray")">@(p.Published ? labelPublished : labelUnpublished)</span>
                            }
                        </td>
                        <td class="mp-col-actions">
                            <button type="button" class="mp-icon-btn" data-open-editor="@editUrl" title="@T("Plugins.MotorShop.AdminPanel.Action.Edit")">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4Zm9-13 4 4" /></svg>
                                <span class="mp-sr">@T("Plugins.MotorShop.AdminPanel.Action.Edit"): @p.Name</span>
                            </button>
                            @if (p.Slug.HasValue())
                            {
                                <a class="mp-icon-btn" href="@Url.RouteUrl("Product", new { SeName = p.Slug, area = "" })" target="_blank" rel="noopener" title="@T("Plugins.MotorShop.AdminPanel.Action.View")">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
                                    <span class="mp-sr">@T("Plugins.MotorShop.AdminPanel.Action.View"): @p.Name</span>
                                </a>
                            }
                            @if (Model.CanCreate)
                            {
                                <button type="button" class="mp-icon-btn" data-duplicate="@Url.Action("Duplicate", "MotorPanelProduct", new { area = "Admin", id = p.Id })" title="@T("Plugins.MotorShop.AdminPanel.Action.Duplicate")">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></svg>
                                    <span class="mp-sr">@T("Plugins.MotorShop.AdminPanel.Action.Duplicate"): @p.Name</span>
                                </button>
                            }
                            @if (Model.CanDelete)
                            {
                                <button type="button" class="mp-icon-btn mp-icon-btn--danger" data-delete="@Url.Action("Delete", "MotorPanelProduct", new { area = "Admin", id = p.Id })" title="@T("Plugins.MotorShop.AdminPanel.Action.Delete")">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M5 7l1 13h12l1-13M9 7V4h6v3" /></svg>
                                    <span class="mp-sr">@T("Plugins.MotorShop.AdminPanel.Action.Delete"): @p.Name</span>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        var first = Math.Max(1, f.Page - 2);
        var last = Math.Min(Model.TotalPages, f.Page + 2);
        <nav class="mp-pager" aria-label="@T("Plugins.MotorShop.AdminPanel.Pagination")">
            @if (f.Page > 1)
            {
                <a class="mp-pager__link" href="@Url.Action("Index", "MotorPanel", f.ToRouteValues(f.Page - 1))#mp-products" rel="prev">‹ @T("Plugins.MotorShop.AdminPanel.Prev")</a>
            }
            @if (first > 1)
            {
                <a class="mp-pager__link" href="@Url.Action("Index", "MotorPanel", f.ToRouteValues(1))#mp-products">1</a>
                @if (first > 2) { <span class="mp-pager__gap">…</span> }
            }
            @for (var i = first; i <= last; i++)
            {
                if (i == f.Page)
                {
                    <span class="mp-pager__link is-current" aria-current="page">@i</span>
                }
                else
                {
                    <a class="mp-pager__link" href="@Url.Action("Index", "MotorPanel", f.ToRouteValues(i))#mp-products">@i</a>
                }
            }
            @if (last < Model.TotalPages)
            {
                @if (last < Model.TotalPages - 1) { <span class="mp-pager__gap">…</span> }
                <a class="mp-pager__link" href="@Url.Action("Index", "MotorPanel", f.ToRouteValues(Model.TotalPages))#mp-products">@Model.TotalPages</a>
            }
            @if (f.Page < Model.TotalPages)
            {
                <a class="mp-pager__link" href="@Url.Action("Index", "MotorPanel", f.ToRouteValues(f.Page + 1))#mp-products" rel="next">@T("Plugins.MotorShop.AdminPanel.Next") ›</a>
            }
        </nav>
    }
}
