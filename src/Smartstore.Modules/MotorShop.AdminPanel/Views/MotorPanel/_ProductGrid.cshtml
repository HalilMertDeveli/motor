@model ProductListModel
@{
    var f = Model.Filter;

    string ListUrl(object values) => Url.Action("Products", "MotorPanel", values);

    string SortUrl(ProductSort asc, ProductSort desc)
        => ListUrl(f.ToRouteValues(1, f.Sort == asc ? desc : asc));

    string AriaSort(ProductSort asc, ProductSort desc)
        => f.Sort == asc ? "ascending" : f.Sort == desc ? "descending" : null;

    var labelPublished = T("Plugins.MotorShop.AdminPanel.Status.Published").Value;
    var labelDraft = T("Plugins.MotorShop.AdminPanel.Status.Draft").Value;
}

<div class="mp-grid__meta" data-total="@Model.TotalCount" data-page-ids="@string.Join(",", Model.Rows.Select(x => x.Id))">
    <span>@T("Plugins.MotorShop.AdminPanel.ResultCount", Model.TotalCount.ToString("N0"))</span>
    <span class="mp-muted">@T("Plugins.MotorShop.AdminPanel.PricesIn", Model.CurrencyCode) · @T("Plugins.MotorShop.AdminPanel.List.InlineHint")</span>
</div>

@if (Model.Rows.Count == 0)
{
    <div class="mp-empty">
        <p>@T("Plugins.MotorShop.AdminPanel.NoProducts")</p>
        <a class="mp-link" href="@ListUrl(new { area = "Admin" })">@T("Plugins.MotorShop.AdminPanel.ResetFilters")</a>
        @if (Model.CanCreate)
        {
            <p><a class="mp-btn mp-btn--accent" href="@Url.Action("New", "MotorPanelProduct", new { area = "Admin" })">+ @T("Plugins.MotorShop.AdminPanel.NewProductLong")</a></p>
        }
    </div>
}
else
{
    <div class="mp-table-wrap">
        <table class="mp-table mp-table--products">
            <thead>
                <tr>
                    @if (Model.CanUpdate)
                    {
                        <th scope="col" class="mp-col-check">
                            <input type="checkbox" class="mp-check" data-select-page aria-label="@T("Plugins.MotorShop.AdminPanel.Bulk.SelectPage")" />
                        </th>
                    }
                    <th scope="col" aria-sort="@AriaSort(ProductSort.NameAsc, ProductSort.NameDesc)">
                        <a class="mp-sort" href="@SortUrl(ProductSort.NameAsc, ProductSort.NameDesc)">@T("Plugins.MotorShop.AdminPanel.Col.Product")</a>
                    </th>
                    <th scope="col" class="mp-num" aria-sort="@AriaSort(ProductSort.PriceAsc, ProductSort.PriceDesc)">
                        <a class="mp-sort" href="@SortUrl(ProductSort.PriceAsc, ProductSort.PriceDesc)">@T("Plugins.MotorShop.AdminPanel.Col.Price")</a>
                    </th>
                    <th scope="col" class="mp-num" aria-sort="@AriaSort(ProductSort.StockAsc, ProductSort.StockDesc)">
                        <a class="mp-sort" href="@SortUrl(ProductSort.StockAsc, ProductSort.StockDesc)">@T("Plugins.MotorShop.AdminPanel.Col.Stock")</a>
                    </th>
                    <th scope="col">@T("Plugins.MotorShop.AdminPanel.Col.Category")</th>
                    <th scope="col">@T("Plugins.MotorShop.AdminPanel.Col.Status")</th>
                    <th scope="col" class="mp-col-actions">@T("Plugins.MotorShop.AdminPanel.Col.Actions")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Rows)
                {
                    // Variant stock needs the classic editor; everything else opens the simple editor.
                    var editUrl = p.Stock == StockState.ByAttributes
                        ? Url.Action("Edit", "Product", new { area = "Admin", id = p.Id })
                        : Url.Action("Simple", "MotorPanelProduct", new { area = "Admin", id = p.Id });
                    var zeroPrice = p.Price.Amount <= 0 && !p.CallForPrice;
                    <tr data-id="@p.Id" data-name="@p.Name">
                        @if (Model.CanUpdate)
                        {
                            <td class="mp-col-check">
                                <input type="checkbox" class="mp-check" data-select value="@p.Id" aria-label="@T("Plugins.MotorShop.AdminPanel.Bulk.SelectRow", p.Name)" />
                            </td>
                        }
                        <td class="mp-col-product">
                            <div class="mp-product-cell">
                                @if (p.ThumbnailUrl.HasValue())
                                {
                                    <img class="mp-thumb" src="@p.ThumbnailUrl" alt="" loading="lazy" width="48" height="48" />
                                }
                                else
                                {
                                    <span class="mp-thumb mp-thumb--empty" aria-hidden="true" title="@T("Plugins.MotorShop.AdminPanel.NoPhoto")"></span>
                                }
                                <span class="mp-product-cell__text">
                                    <a class="mp-link mp-link--plain mp-product-cell__name" href="@editUrl">@p.Name</a>
                                    <span class="mp-muted mp-small mp-mono">@(p.Sku.NullEmpty() ?? "-")</span>
                                </span>
                            </div>
                        </td>
                        <td class="mp-num mp-nowrap mp-col-price">
                            @if (Model.CanUpdate)
                            {
                                <button type="button" class="mp-cell" data-edit="price" data-value="@p.PriceValue"
                                        aria-label="@T("Plugins.MotorShop.AdminPanel.Edit.Price", p.Name)">@p.Price</button>
                            }
                            else
                            {
                                @p.Price
                            }
                            <span class="mp-price-badges">
                                <span class="mp-badge mp-badge--red" data-zero-badge title="@T("Plugins.MotorShop.AdminPanel.ZeroPrice.Hint")" hidden="@(!zeroPrice)">@T("Plugins.MotorShop.AdminPanel.ZeroPrice")</span>
                                @if (p.CallForPrice)
                                {
                                    <span class="mp-badge mp-badge--amber" title="@T("Plugins.MotorShop.AdminPanel.Card.CallForPriceHint")">@T("Plugins.MotorShop.AdminPanel.Price.CallForPrice")</span>
                                }
                                @if (p.SpecialPrice.HasValue && p.SpecialPriceActive)
                                {
                                    <span class="mp-badge mp-badge--blue">@T("Plugins.MotorShop.AdminPanel.Col.SpecialPrice"): @p.SpecialPrice.Value</span>
                                }
                            </span>
                        </td>
                        <td class="mp-num mp-nowrap mp-col-stock">
                            @switch (p.Stock)
                            {
                                case StockState.InStock:
                                case StockState.OutOfStock:
                                    if (Model.CanUpdate)
                                    {
                                        <button type="button" class="mp-cell mp-badge @(p.Stock == StockState.InStock ? "mp-badge--green" : "mp-badge--red")" data-edit="stock" data-value="@p.StockQuantity" data-integer="true"
                                                aria-label="@T("Plugins.MotorShop.AdminPanel.Edit.Stock", p.Name)">@p.StockQuantity.ToString("N0")</button>
                                    }
                                    else
                                    {
                                        <span class="mp-badge @(p.Stock == StockState.InStock ? "mp-badge--green" : "mp-badge--red")">@p.StockQuantity.ToString("N0")</span>
                                    }
                                    break;
                                case StockState.ByAttributes:
                                    <span class="mp-badge mp-badge--gray">@T("Plugins.MotorShop.AdminPanel.Stock.ByAttributes")</span>
                                    break;
                                default:
                                    <span class="mp-badge mp-badge--gray">@T("Plugins.MotorShop.AdminPanel.Stock.NotTracked")</span>
                                    break;
                            }
                        </td>
                        <td class="mp-col-cats">
                            @if (p.Categories.Count == 0)
                            {
                                <span class="mp-text-warn">@T("Plugins.MotorShop.AdminPanel.NoCategory")</span>
                            }
                            else
                            {
                                <span class="mp-truncate" title="@string.Join(", ", p.Categories)">@p.Categories[0]</span>
                                @if (p.Categories.Count > 1)
                                {
                                    <span class="mp-muted mp-small" title="@string.Join(", ", p.Categories.Skip(1))">+@(p.Categories.Count - 1)</span>
                                }
                            }
                        </td>
                        <td class="mp-col-status">
                            @if (Model.CanUpdate)
                            {
                                <button type="button" class="mp-badge mp-badge-btn @(p.Published ? "mp-badge--green" : "mp-badge--gray")" data-toggle="published" data-value="@(p.Published ? "true" : "false")"
                                        data-label-true="@labelPublished" data-label-false="@labelDraft" data-class-true="mp-badge--green" data-class-false="mp-badge--gray"
                                        title="@T("Plugins.MotorShop.AdminPanel.Toggle.PublishHint")">@(p.Published ? labelPublished : labelDraft)</button>
                            }
                            else
                            {
                                <span class="mp-badge @(p.Published ? "mp-badge--green" : "mp-badge--gray")">@(p.Published ? labelPublished : labelDraft)</span>
                            }
                        </td>
                        <td class="mp-col-actions">
                            <div class="mp-row-actions">
                                <a class="mp-btn mp-btn--outline mp-btn--sm" href="@editUrl">
                                    @T("Plugins.MotorShop.AdminPanel.Action.Edit")<span class="mp-sr">: @p.Name</span>
                                </a>
                                @if (p.Slug.HasValue())
                                {
                                    <a class="mp-btn mp-btn--ghost mp-btn--sm" href="@Url.RouteUrl("Product", new { SeName = p.Slug, area = "" })" target="_blank" rel="noopener"
                                       title="@(p.Published ? null : T("Plugins.MotorShop.AdminPanel.ViewOnSite.DraftHint").Value)">
                                        @T("Plugins.MotorShop.AdminPanel.ViewOnSite")<span class="mp-sr">: @p.Name</span>
                                    </a>
                                }
                                <details class="mp-row-more" data-menu data-menu-fixed>
                                    <summary class="mp-icon-btn" title="@T("Plugins.MotorShop.AdminPanel.Action.More")">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.2" /><circle cx="12" cy="12" r="1.2" /><circle cx="19" cy="12" r="1.2" /></svg>
                                        <span class="mp-sr">@T("Plugins.MotorShop.AdminPanel.Action.More"): @p.Name</span>
                                    </summary>
                                    <ul class="mp-menu">
                                        <li>
                                            <button type="button" class="mp-menu__item" data-open-editor="@Url.Action("Edit", "MotorPanelProduct", new { area = "Admin", id = p.Id })">@T("Plugins.MotorShop.AdminPanel.Action.AdvancedEdit")</button>
                                        </li>
                                        <li>
                                            <a class="mp-menu__item" href="@Url.Action("Edit", "Product", new { area = "Admin", id = p.Id })">@T("Plugins.MotorShop.AdminPanel.Editor.OpenClassic")</a>
                                        </li>
                                        @if (Model.CanCreate)
                                        {
                                            <li>
                                                <button type="button" class="mp-menu__item" data-duplicate="@Url.Action("Duplicate", "MotorPanelProduct", new { area = "Admin", id = p.Id })">@T("Plugins.MotorShop.AdminPanel.Action.Duplicate")</button>
                                            </li>
                                        }
                                        @if (Model.CanDelete)
                                        {
                                            <li>
                                                <button type="button" class="mp-menu__item mp-menu__item--danger" data-delete="@Url.Action("Delete", "MotorPanelProduct", new { area = "Admin", id = p.Id })">@T("Plugins.MotorShop.AdminPanel.Action.Delete")</button>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        var first = Math.Max(1, f.Page - 2);
        var last = Math.Min(Model.TotalPages, f.Page + 2);
        <nav class="mp-pager" aria-label="@T("Plugins.MotorShop.AdminPanel.Pagination")">
            @if (f.Page > 1)
            {
                <a class="mp-pager__link" href="@ListUrl(f.ToRouteValues(f.Page - 1))" rel="prev">‹ @T("Plugins.MotorShop.AdminPanel.Prev")</a>
            }
            @if (first > 1)
            {
                <a class="mp-pager__link" href="@ListUrl(f.ToRouteValues(1))">1</a>
                @if (first > 2) { <span class="mp-pager__gap">…</span> }
            }
            @for (var i = first; i <= last; i++)
            {
                if (i == f.Page)
                {
                    <span class="mp-pager__link is-current" aria-current="page">@i</span>
                }
                else
                {
                    <a class="mp-pager__link" href="@ListUrl(f.ToRouteValues(i))">@i</a>
                }
            }
            @if (last < Model.TotalPages)
            {
                @if (last < Model.TotalPages - 1) { <span class="mp-pager__gap">…</span> }
                <a class="mp-pager__link" href="@ListUrl(f.ToRouteValues(Model.TotalPages))">@Model.TotalPages</a>
            }
            @if (f.Page < Model.TotalPages)
            {
                <a class="mp-pager__link" href="@ListUrl(f.ToRouteValues(f.Page + 1))" rel="next">@T("Plugins.MotorShop.AdminPanel.Next") ›</a>
            }
        </nav>
    }
}
