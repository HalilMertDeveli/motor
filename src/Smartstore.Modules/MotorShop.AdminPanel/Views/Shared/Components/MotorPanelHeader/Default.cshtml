@model PanelHeaderModel

<style>:root { --mp-accent: @Model.AccentColor; }</style>

<header class="mp-header">
    <div class="mp-header__inner">
        <a class="mp-brand" href="@Url.Action("Index", "MotorPanel", new { area = "Admin" })">
            @if (Model.LogoUrl.HasValue())
            {
                <img class="mp-brand__logo" src="@Model.LogoUrl" alt="@Model.StoreName" />
            }
            else
            {
                <span class="mp-brand__mark" aria-hidden="true">@(Model.StoreName?.Length > 0 ? Model.StoreName[..1] : "M")</span>
            }
            <span class="mp-brand__text">
                <span class="mp-brand__title">@Model.Title</span>
                <span class="mp-brand__subtitle">@T("Plugins.MotorShop.AdminPanel.Subtitle")</span>
            </span>
        </a>

        <nav class="mp-header__actions" aria-label="@T("Plugins.MotorShop.AdminPanel.AccountNav")">
            <span class="mp-user" title="@T("Plugins.MotorShop.AdminPanel.SignedInAs"): @Model.UserName">
                <span class="mp-user__avatar" aria-hidden="true">@(Model.UserName?.Length > 0 ? Model.UserName[..1].ToUpperInvariant() : "?")</span>
                <span class="mp-user__name">@Model.UserName</span>
            </span>
            <a class="mp-btn mp-btn--ghost" href="@Url.Content("~/")" target="_blank" rel="noopener">@T("Plugins.MotorShop.AdminPanel.ViewSite")</a>
            <a class="mp-btn mp-btn--outline" href="@Url.RouteUrl("Logout")">@T("Plugins.MotorShop.AdminPanel.Logout")</a>
        </nav>
    </div>
</header>

@{
    var moreActive = Model.MoreTabs.Any(x => x.Key == Model.ActiveTab);
}
<nav class="mp-tabs" aria-label="@T("Plugins.MotorShop.AdminPanel.ModuleNav")">
    <div class="mp-tabs__inner">
        <ul class="mp-tabs__list">
            @foreach (var tab in Model.Tabs)
            {
                var active = tab.Key == Model.ActiveTab;
                <li>
                    <a class="mp-tabs__link@(active ? " is-active" : "")" href="@tab.Url" aria-current="@(active ? "page" : null)">@tab.Title</a>
                </li>
            }
        </ul>
        @if (Model.MoreTabs.Count > 0)
        {
            <details class="mp-more" data-menu>
                <summary class="mp-tabs__link mp-more__toggle@(moreActive ? " is-active" : "")">
                    @T("Plugins.MotorShop.AdminPanel.Tab.More")
                    <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                </summary>
                <ul class="mp-menu">
                    @foreach (var tab in Model.MoreTabs)
                    {
                        var active = tab.Key == Model.ActiveTab;
                        <li>
                            <a class="mp-menu__item@(active ? " is-active" : "")" href="@tab.Url" aria-current="@(active ? "page" : null)">
                                @tab.Title
                                @if (tab.Classic)
                                {
                                    <span class="mp-muted mp-small">· @T("Plugins.MotorShop.AdminPanel.Tab.Advanced")</span>
                                }
                            </a>
                        </li>
                    }
                </ul>
            </details>
        }
    </div>
</nav>
