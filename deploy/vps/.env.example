# MOTOR VPS settings. Copy to ".env" in this directory on the server and fill in.
#   chmod 600 .env
# .env is git-ignored. Never commit it, paste it into chat or put it in a PR.
# Every value below is a placeholder.

# --- Stack ------------------------------------------------------------------
# Use different names for preview and production stacks on the same host.
MOTOR_PROJECT_NAME=motor

# --- Image ------------------------------------------------------------------
# Built by .github/workflows/motor-image.yml from the motor branch.
# Always an immutable tag (the commit SHA), never "latest", so rollback is exact.
MOTOR_IMAGE=ghcr.io/halilmertdeveli/motor-web
MOTOR_IMAGE_TAG=sha-0000000

# --- Public address ------------------------------------------------------------
# Store domain(s). Several domains: separate with ";" (first one is used by the
# health check). DNS must point to this VPS before the first start.
MOTOR_DOMAIN=shop.example.com
# Let's Encrypt account e-mail (expiry notices)
MOTOR_ACME_EMAIL=owner@example.com
# Largest accepted request body in bytes (product images, imports). Enforced by
# Caddy and by the app (Smartstore default would be 2 GB). 67108864 = 64 MiB.
MOTOR_MAX_UPLOAD_BYTES=67108864

# --- Database: Supabase PostgreSQL ------------------------------------------------
# Full Npgsql connection string, see docs/motor/supabase.md. Copy host and user
# from the Supabase "Connect" dialog. Preview and production use different projects.
# Put the Supabase CA certificate at ./secrets/supabase-ca.crt.
MOTOR_DB_CONNECTION_STRING=Host=<host>;Port=5432;Database=postgres;Username=<user>;Password=<password>;SSL Mode=VerifyFull;Root Certificate=/run/secrets/supabase-ca.crt;Maximum Pool Size=10;Minimum Pool Size=0;Connection Idle Lifetime=60;Timeout=15;Command Timeout=60;Keepalive=30;Include Error Detail=false

# --- Runtime ------------------------------------------------------------------
MOTOR_TZ=Europe/Istanbul
# "/" works always; switch to "/healthz/ready" once MotorShop.Security is installed.
MOTOR_HEALTH_PATH=/
# Docker network between Caddy and the app. Outside Docker's default pools
# (172.17-31.x, 192.168.x); change only if it collides with another network.
MOTOR_EDGE_SUBNET=10.203.40.0/24
# Resource limits for the app container
MOTOR_WEB_CPUS=2.0
MOTOR_WEB_MEMORY=3g
#MOTOR_CADDY_TAG=2.10-alpine

# --- Backups (scripts/backup.sh, systemd/motor-backup.timer) ------------------
# Encrypted with the owner's GPG public key at ./secrets/backup-public.asc.
# Local copies kept for this many days (off-site retention: set on the bucket).
MOTOR_BACKUP_KEEP_DAYS=14
# rclone remote and path for the off-site copy (config in ./secrets/rclone.conf),
# e.g. b2:motor-backups or r2:motor-backups. Empty = no off-site copy (not for production).
MOTOR_BACKUP_RCLONE_REMOTE=
# pg_dump client image: major version >= the Supabase server's major version.
MOTOR_BACKUP_PG_IMAGE=postgres:17-alpine
# Dead-man's switch for backups, e.g. https://hc-ping.com/<uuid> (start, success, /fail)
MOTOR_BACKUP_PING_URL=

# --- Monitoring (scripts/monitor.sh, systemd/motor-monitor.timer) -------------
MOTOR_MONITOR_PING_URL=
MOTOR_MONITOR_DISK_MAX_PERCENT=85
MOTOR_MONITOR_BACKUP_MAX_HOURS=26
