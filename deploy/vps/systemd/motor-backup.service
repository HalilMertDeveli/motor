# MOTOR nightly backup. Install (as root), adjusting User= and the path:
#   cp deploy/vps/systemd/motor-*.service deploy/vps/systemd/motor-*.timer /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now motor-backup.timer motor-monitor.timer
[Unit]
Description=MOTOR encrypted backup (database + App_Data)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=motor
WorkingDirectory=/opt/motor/deploy/vps
ExecStart=/opt/motor/deploy/vps/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
