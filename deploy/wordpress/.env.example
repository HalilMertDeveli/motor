# Copy to .env (git ignored) and fill in. Never commit .env.

WP_PROJECT_NAME=motor-wordpress
WP_PORT=8097

# MariaDB passwords for WordPress only. Generate long random values.
WP_DB_PASSWORD=
WP_DB_ROOT_PASSWORD=

# Public URL of the MOTOR store. WordPress front-end visits are redirected there (no duplicate content).
MOTOR_STORE_URL=https://www.example.com

# Optional: MOTOR cache purge webhook, called when content is published, updated or removed.
# Same value as MotorShop__WordPress__WebhookSecret in MOTOR, at least 32 characters.
MOTOR_WEBHOOK_URL=https://www.example.com/wordpress/webhook/purge
MOTOR_WEBHOOK_SECRET=

# Slug of the category shown under /rehberler in MOTOR.
MOTOR_GUIDE_CATEGORY=rehberler
