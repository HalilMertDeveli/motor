# MOTOR Docker Compose settings.
# Copy to .env (development) or keep a separate .env on the server
# (production). .env files are ignored by git and Docker; never commit one.
# The values below are placeholders, not working credentials.

# --- Compose ---------------------------------------------------------------
# Web app plus one database file. Separator ":" works on every OS because of
# COMPOSE_PATH_SEPARATOR.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.mysql.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.sqlserver.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.postgres.yml

# Compose project name: prefixes containers, network and volumes.
# Use a different name for every isolated stack (dev, qa, prod).
MOTOR_PROJECT_NAME=motor

# --- Web -------------------------------------------------------------------
MOTOR_IMAGE=motor-web
MOTOR_IMAGE_TAG=local
# Git commit baked into the image labels. Set per build, e.g.
#   MOTOR_REVISION=$(git rev-parse HEAD) docker compose build
#MOTOR_REVISION=
# Development: 127.0.0.1. Production: 127.0.0.1 behind a reverse proxy on the
# same host; use 0.0.0.0 only if the proxy runs elsewhere and a firewall
# restricts access.
MOTOR_HTTP_BIND=127.0.0.1
MOTOR_HTTP_PORT=8080
MOTOR_TZ=Europe/Istanbul

# --- Database --------------------------------------------------------------
# MySQL/PostgreSQL: the app connects with MOTOR_DB_USER/MOTOR_DB_PASSWORD.
# SQL Server: the app connects as "sa" with MOTOR_DB_ROOT_PASSWORD (min. 8
# chars, upper/lower case, digit, symbol).
# Required, left empty on purpose: Compose refuses to start until set.
# Generate real values, e.g.:  openssl rand -base64 24
MOTOR_DB_NAME=motor
MOTOR_DB_USER=motor
MOTOR_DB_PASSWORD=
MOTOR_DB_ROOT_PASSWORD=

# Image tags (pin exact versions in production)
#MOTOR_MYSQL_TAG=8.4
#MOTOR_MSSQL_TAG=2022-latest
#MOTOR_MSSQL_PID=Express
#MOTOR_POSTGRES_TAG=16-alpine
